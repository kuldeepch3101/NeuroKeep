<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F6F8"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Score circle -->
        <FrameLayout
            android:id="@+id/scoreCircle"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/txtScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0/5"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#1E1924"/>
        </FrameLayout>

        <!-- Emoji result label -->
        <TextView
            android:id="@+id/txtScoreLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🎉 Excellent!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E1924"
            android:layout_marginTop="12dp"/>

        <!-- Confidence change -->
        <TextView
            android:id="@+id/txtConfChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <!-- Next reminder -->
        <TextView
            android:id="@+id/txtNextReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="14sp"
            android:textColor="#7249A9"
            android:layout_marginTop="6dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E9DFEF"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Review Answers"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1E1924"
            android:layout_marginBottom="12dp"/>

        <!-- Q&A review cards injected here -->
        <LinearLayout
            android:id="@+id/layoutReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <!-- Mark Complete button -->
        <Button
            android:id="@+id/btnMarkComplete"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="✅ Mark Topic as Complete"
            android:textColor="#FFFFFF"
            android:backgroundTint="#22C55E"
            android:layout_marginTop="24dp"/>

        <!-- Back button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="← Back to Topics"
            android:textColor="#7F13EC"
            android:background="@android:color/transparent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
